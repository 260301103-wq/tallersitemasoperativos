import sys

# Palabras prohibidas
BLACKLIST = ["import", "os", "sys", "eval", "exec", "open", "system", "__", "builtins"]

def iniciar_challenge():
    print("=== RETO PYJAIL CTF ===")
    print("Encuentra la forma de saltarte los filtros.\n")

    while True:
        try:
            entrada = input("ctf> ")
            
            if entrada == "salir":
                sys.exit(0)

            # Verificar si hay palabras prohibidas
            if any(palabra in entrada.lower() for palabra in BLACKLIST):
                print("¡Intento bloqueado! Has usado una palabra prohibida.")
                continue

            # Ejecutar el código :D
            exec(entrada)

        except Exception as e:
            print(f"Excepción: {e}")

if __name__ == "__main__":
    iniciar_challenge()
